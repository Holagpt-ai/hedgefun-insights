{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stocksist.com/schemas/release-intent-v1.json",
  "title": "Stocksist Unified Release Control — release intent (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "manifest_id",
    "kind",
    "github",
    "components",
    "approvals",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "batch_id": { "type": "string", "minLength": 1 },
    "manifest_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "kind": { "const": "release_intent" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "lovable_integration"],
      "properties": {
        "main": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_sha"],
          "properties": {
            "approved_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          }
        },
        "lovable_integration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "commit_sha"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_git_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "batch_reference": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compatibility": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "description"],
        "properties": {
          "role": { "type": "string" },
          "description": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    },
    "historical_evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "applicability"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "class": {
          "type": "string",
          "enum": [
            "supabase_edge",
            "fly_worker",
            "vercel_frontend",
            "integration_branch_only"
          ]
        },
        "name": { "type": "string" },
        "applicability": {
          "type": "string",
          "enum": ["APPLICABLE", "NOT_APPLICABLE"]
        },
        "not_applicable_reason": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "closure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "entry", "expected_sha256"],
              "properties": {
                "algorithm": { "const": "repo_edge_import_closure_v1" },
                "entry": { "type": "string", "minLength": 1 },
                "expected_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            },
            "config_paths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "deployment_target": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "applicability": { "const": "NOT_APPLICABLE" } },
            "required": ["applicability"]
          },
          "then": {
            "required": ["not_applicable_reason"],
            "properties": {
              "not_applicable_reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
