# Gateway process only. Do not commit real values.
# STOCKSIST_SEC_GATEWAY_SECRET must match the Catalyst SEC_GATEWAY_SECRET.
STOCKSIST_SEC_GATEWAY_SECRET=
# SEC-facing identity. Organization plus contact email. Never log this value.
SEC_USER_AGENT=
# Optional marker recorded after egress verification. Not an IP lookup.
SEC_EGRESS_IDENTITY=
SEC_LATEST_FILINGS_MIN_INTERVAL_SECONDS=240
SEC_LATEST_FILINGS_TRANSPORT_TTL_SECONDS=240
PORT=8080
